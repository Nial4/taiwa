<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security"
        android:supportsRtl="false">

        <!-- Launched by the Android TV Remote Service as the default assistant
             (Settings.Secure.ASSISTANT) when the remote's Assistant button is pressed.
             Recording only receives the remote's microphone during that assist flow. -->
        <activity
            android:name=".ChatActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.nial4.taiwa.panel"
            android:theme="@style/Theme.Taiwa.Panel">
            <meta-data
                android:name="com.android.systemui.action_assist_icon"
                android:resource="@drawable/ic_assist_orb" />
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <action android:name="android.intent.action.VOICE_ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- adb shell am broadcast -n io.github.nial4.taiwa/.ConfigReceiver [-\-es url http://HOST:8787] [-\-es token TOKEN] [-\-es voice NAME]
             Restricted to holders of DUMP (the adb shell), so other apps cannot repoint the relay. -->
        <receiver
            android:name=".ConfigReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
